{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "taskId": {
      "type": "string",
      "const": "TG-01"
    },
    "publishedVersionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "configVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "configurationHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gameBuildId": {
      "type": "string",
      "const": "tg01-reference-rebuild-1"
    },
    "contractVersion": {
      "type": "string",
      "const": "1.0"
    },
    "config": {
      "type": "object",
      "properties": {
        "durationMs": {
          "type": "number",
          "const": 120000
        },
        "segmentBoundariesMs": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 40000
            },
            {
              "type": "number",
              "const": 80000
            },
            {
              "type": "number",
              "const": 120000
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "logicalWidth": {
          "type": "number",
          "const": 960
        },
        "logicalHeight": {
          "type": "number",
          "const": 600
        },
        "lanes": {
          "type": "number",
          "const": 6
        },
        "fallSpeedUnitsPerSecond": {
          "type": "number",
          "const": 210
        },
        "spawnIntervalMs": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number",
              "const": 1100
            },
            "max": {
              "type": "number",
              "const": 1800
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "starProbability": {
          "type": "number",
          "const": 0.7
        },
        "stimulusSizeUnits": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number",
              "const": 75
            },
            "max": {
              "type": "number",
              "const": 105
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "minimumDistanceUnits": {
          "type": "number",
          "const": 180
        },
        "positionAttempts": {
          "type": "number",
          "const": 30
        },
        "presentationRule": {
          "type": "string",
          "const": "FULLY_VISIBLE"
        },
        "maxFrameGapMs": {
          "type": "number",
          "const": 250
        },
        "minimumStageScale": {
          "type": "number",
          "const": 0.6
        },
        "inputProfile": {
          "type": "string",
          "const": "POINTER_V1"
        }
      },
      "required": [
        "durationMs",
        "segmentBoundariesMs",
        "logicalWidth",
        "logicalHeight",
        "lanes",
        "fallSpeedUnitsPerSecond",
        "spawnIntervalMs",
        "starProbability",
        "stimulusSizeUnits",
        "minimumDistanceUnits",
        "positionAttempts",
        "presentationRule",
        "maxFrameGapMs",
        "minimumStageScale",
        "inputProfile"
      ],
      "additionalProperties": false
    },
    "executionStatus": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "attemptNumber": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        {
          "type": "null"
        }
      ]
    },
    "startAllowedUntil": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "uploadAllowedUntil": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "serverTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "canStart": {
          "type": "boolean"
        },
        "canSubmit": {
          "type": "boolean"
        },
        "canReadReceipt": {
          "type": "boolean"
        }
      },
      "required": [
        "canStart",
        "canSubmit",
        "canReadReceipt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "sessionId",
    "taskId",
    "publishedVersionId",
    "configVersion",
    "configurationHash",
    "gameBuildId",
    "contractVersion",
    "config",
    "executionStatus",
    "attemptNumber",
    "startAllowedUntil",
    "uploadAllowedUntil",
    "serverTime",
    "capabilities"
  ],
  "additionalProperties": false
}
