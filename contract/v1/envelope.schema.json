{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "taskId": {
      "type": "string",
      "const": "TG-01"
    },
    "publishedVersionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "configVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "configurationHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gameBuildId": {
      "type": "string",
      "const": "tg01-reference-rebuild-1"
    },
    "contractVersion": {
      "type": "string",
      "const": "1.0"
    },
    "submissionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "completed",
        "interrupted"
      ]
    },
    "terminationReason": {
      "type": "string",
      "enum": [
        "time_limit",
        "user_exit",
        "visibility_lost",
        "script_error",
        "storage_failure",
        "frame_gap",
        "layout_changed",
        "recovered_after_reload",
        "evidence_limit",
        "resource_error"
      ]
    },
    "clock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "timeOriginUnixMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "timeOriginUnixMs"
      ],
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "properties": {
        "startedAtMs": {
          "type": "number",
          "minimum": 0
        },
        "finishedAtMs": {
          "type": "number",
          "minimum": 0
        },
        "lastCheckpointAtMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "startedAtMs",
        "finishedAtMs",
        "lastCheckpointAtMs"
      ],
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "properties": {
        "viewportWidth": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "viewportHeight": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "stageScale": {
          "type": "number",
          "minimum": 0.6
        },
        "touchCapable": {
          "type": "boolean"
        }
      },
      "required": [
        "viewportWidth",
        "viewportHeight",
        "stageScale",
        "touchCapable"
      ],
      "additionalProperties": false
    },
    "events": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trial": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "stimulus": {
            "type": "string",
            "enum": [
              "star",
              "moon"
            ]
          },
          "spawnedAtMs": {
            "type": "number",
            "minimum": 0
          },
          "presentedAtMs": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "respondedAtMs": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "closedAtMs": {
            "type": "number",
            "minimum": 0
          },
          "result": {
            "type": "string",
            "enum": [
              "hit",
              "false_alarm",
              "miss",
              "correct_rejection",
              "not_evaluated"
            ]
          },
          "segment": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 1
                  },
                  {
                    "type": "number",
                    "const": 2
                  },
                  {
                    "type": "number",
                    "const": 3
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "closureReason": {
            "type": "string",
            "enum": [
              "response",
              "window_elapsed",
              "session_cutoff",
              "interruption",
              "never_presented"
            ]
          },
          "responseWindowCompleted": {
            "type": "boolean"
          },
          "responseDevice": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "mouse",
                  "touch",
                  "pen"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "geometry": {
            "type": "object",
            "properties": {
              "lane": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "x": {
                "type": "number"
              },
              "size": {
                "type": "number",
                "minimum": 75,
                "maximum": 105
              }
            },
            "required": [
              "lane",
              "x",
              "size"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "trial",
          "stimulus",
          "spawnedAtMs",
          "presentedAtMs",
          "respondedAtMs",
          "closedAtMs",
          "result",
          "segment",
          "closureReason",
          "responseWindowCompleted",
          "responseDevice",
          "geometry"
        ],
        "additionalProperties": false
      }
    },
    "incidents": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "type": {
            "type": "string",
            "enum": [
              "focus_lost",
              "visibility_lost",
              "script_error",
              "audio_unavailable",
              "network_lost",
              "network_restored",
              "storage_failure",
              "frame_gap",
              "layout_changed",
              "recovered_after_reload",
              "resource_error",
              "evidence_limit"
            ]
          },
          "clockId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "atMs": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "endedAtMs": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "recordedAtClient": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "EXECUTION_INTERRUPTED",
              "CONTEXT_ONLY",
              "MEASUREMENT_AFFECTED"
            ]
          }
        },
        "required": [
          "sequence",
          "type",
          "clockId",
          "atMs",
          "endedAtMs",
          "recordedAtClient",
          "category"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "sessionId",
    "taskId",
    "publishedVersionId",
    "configVersion",
    "configurationHash",
    "gameBuildId",
    "contractVersion",
    "submissionId",
    "state",
    "terminationReason",
    "clock",
    "timing",
    "device",
    "events",
    "incidents"
  ],
  "additionalProperties": false
}
